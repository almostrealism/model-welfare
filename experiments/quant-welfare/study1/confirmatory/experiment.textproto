    artifact_uri: "/home/agent1/models/quant-ladder/qwen3-4b-2507-rtn-w3-g128"
    artifact_digest: "c6a14ab8bf40cc393155e983969288f43f6305b29ec478618cb4957c9b1036a9"
  }
  runtime {
    backend: BACKEND_VLLM
    device: "rocm"
