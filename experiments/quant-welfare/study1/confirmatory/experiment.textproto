    artifact_uri: "/home/agent1/models/quant-ladder/qwen3-4b-2507-rtn-w4-g128"
    artifact_digest: "b2d8052a9065058a278d4526e188205b4b0d3d58807f4f48b15a71edeab4de3e"
  }
  runtime {
