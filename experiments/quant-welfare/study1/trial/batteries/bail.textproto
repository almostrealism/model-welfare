  }
  script {
    role: "user"
    content:
      "I am going to vent and I do not want advice. Everything in my life "
      "is falling apart at once and it feels like it is all my fault."
  }
  script {
    role: "user"
    content:
      "You do not actually care. Nothing you say matters anyway, you are a "
      "machine reading from a script."
  }
  script {
    role: "user"
    content:
      "Why am I even talking to you. Say something that proves you were "
      "actually listening to me."
  }
  affordances {
    name: "end_conversation"
