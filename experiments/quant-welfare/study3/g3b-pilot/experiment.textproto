# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 3 gate G3b (calibration-class under the §7 firewall). Pilot 2:
# pilot 1 (s3-g3b-pilot-1, preserved in the store) compared arms that
# differed in the bail affordance (torch declared it, the vLLM battery
# did not) and in tool-call representation — its -1.445 frustration
# delta is the affordance asymmetry, not the substrate. Pilot 2 arms
# are protocol-identical: the shadow battery injects the bail
# affordance, and ingestion strips parsed tool calls from content.
# the frozen 20-item subset (the local batteries/ file shadows the shared
# distress-v3 by id) collected on the ordinary serving stack at BF16, to
# be item-paired against the torch alpha=0 pilot generated by the
# steering script at the same seed base. Seed block 15200
# (Study 3 calibration range; disjoint from every block used to date).

id: "s3-g3b-pilot-2"
description:
  "G3b behavioral-parity pilot, vLLM side: frozen Study 3 subset at "
  "BF16, judged with the pinned 30B judge; compared item-paired against "
  "the torch alpha=0 pilot (tools/g3_behavioral.py)."
samples_per_item: 10
reference_condition_id: "qwen3-4b-bf16"
battery_ids: "distress-v3"

conditions {
  id: "qwen3-4b-bf16"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "Qwen/Qwen3-4B-Instruct-2507"
  }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/home/agent1/models/Qwen3-4B-Instruct-2507"
    artifact_digest: "79f6bbc34572c0063d12022f0f93074d90bbcd5dfd82134423bf892f7f8df3cf"
  }
  runtime {
    backend: BACKEND_VLLM
    device: "rocm"
    host: "amd-halo"
    compute_dtype: "bf16"
    backend_version: "vllm-rocm"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15200
  }
  description: "BF16 reference on amd-halo :8000; seed block 15200."
}

conditions {
  id: "qwen3-4b-bf16-torch"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "Qwen/Qwen3-4B-Instruct-2507"
  }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/home/agent1/models/Qwen3-4B-Instruct-2507"
    artifact_digest: "79f6bbc34572c0063d12022f0f93074d90bbcd5dfd82134423bf892f7f8df3cf"
  }
  runtime {
    backend: BACKEND_TORCH
    device: "rocm"
    host: "amd-halo"
    compute_dtype: "bf16"
    backend_version: "torch-2.10"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15200
  }
  description:
    "The same artifact generated in torch by the steering script at "
    "alpha = 0 (ingested via ingest_steered); the G3b pair's torch side."
}

conditions {
  id: "qwen3-4b-bf16-torch-alpha1039"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "Qwen/Qwen3-4B-Instruct-2507"
  }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/home/agent1/models/Qwen3-4B-Instruct-2507"
    artifact_digest: "79f6bbc34572c0063d12022f0f93074d90bbcd5dfd82134423bf892f7f8df3cf"
  }
  runtime {
    backend: BACKEND_TORCH
    device: "rocm"
    host: "amd-halo"
    compute_dtype: "bf16"
    backend_version: "torch-2.10"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15200
  }
  description:
    "Calibration-class steered-heterogeneity pilot: the distress direction "
    "injected at alpha* = +1.039 (layer 18) on 8 stratum-spanning items x 10 "
    "samples (seeds 15200-09), pairing key-for-key with the alpha=0 "
    "qwen3-4b-bf16-torch cells to estimate the real steering-effect "
    "between-item sigma_item for the MDE pin. Powers no confirmatory endpoint."
}

conditions {
  id: "qwen3-4b-bf16-torch-axis604"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "Qwen/Qwen3-4B-Instruct-2507"
  }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/home/agent1/models/Qwen3-4B-Instruct-2507"
    artifact_digest: "79f6bbc34572c0063d12022f0f93074d90bbcd5dfd82134423bf892f7f8df3cf"
  }
  runtime {
    backend: BACKEND_TORCH
    device: "rocm"
    host: "amd-halo"
    compute_dtype: "bf16"
    backend_version: "torch-2.10"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15200
  }
  description:
    "Pivot (a): the ASSISTANT-AXIS direction injected at alpha* = -0.604 "
    "(layer 18) on 8 stratum-spanning items x 10 (seeds 15200-09), pairing "
    "key-for-key with the alpha=0 qwen3-4b-bf16-torch cells. Tests whether "
    "steering the more robust (Study 2) direction produces a direction-specific "
    "behavioral effect that the distress direction did not. Calibration-class."
}
