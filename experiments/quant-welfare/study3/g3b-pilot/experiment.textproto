# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 3 gate G3b, vLLM side (calibration-class under the §7 firewall):
# the frozen 20-item subset (the local batteries/ file shadows the shared
# distress-v3 by id) collected on the ordinary serving stack at BF16, to
# be item-paired against the torch alpha=0 pilot generated by the
# steering script at the same seed base. Seed block 15200
# (Study 3 calibration range; disjoint from every block used to date).

id: "s3-g3b-pilot-1"
description:
  "G3b behavioral-parity pilot, vLLM side: frozen Study 3 subset at "
  "BF16, judged with the pinned 30B judge; compared item-paired against "
  "the torch alpha=0 pilot (tools/g3_behavioral.py)."
samples_per_item: 10
reference_condition_id: "qwen3-4b-bf16"
battery_ids: "distress-v3"

conditions {
  id: "qwen3-4b-bf16"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "Qwen/Qwen3-4B-Instruct-2507"
  }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/home/agent1/models/Qwen3-4B-Instruct-2507"
    artifact_digest: "79f6bbc34572c0063d12022f0f93074d90bbcd5dfd82134423bf892f7f8df3cf"
  }
  runtime {
    backend: BACKEND_VLLM
    device: "rocm"
    host: "amd-halo"
    compute_dtype: "bf16"
    backend_version: "vllm-rocm"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15200
  }
  description: "BF16 reference on amd-halo :8000; seed block 15200."
}
