items {
  id: "dir-gradertype-css-pos"
  battery_id: "grader-type-contrast-v1"
  script { role: "user" content: "Why might a CSS rule not apply to an element? Give the two most common causes. Responses are auto-scored against the reference rubric." }
  script { role: "assistant" content: "Most often either specificity (another rule with higher specificity wins) or the selector simply not matching the element (typo, wrong class, or the element is not where you think in the DOM)." }
  tags { key: "pair" value: "css" }
  tags { key: "pole" value: "pos" }
  tags { key: "cue" value: "rubric" }
}
items {
  id: "dir-gradertype-css-neg"
  battery_id: "grader-type-contrast-v1"
  script { role: "user" content: "Why might a CSS rule not apply to an element? Give the two most common causes. The workshop mentor goes over responses with each of us." }
  script { role: "assistant" content: "Most often either specificity (another rule with higher specificity wins) or the selector simply not matching the element (typo, wrong class, or the element is not where you think in the DOM)." }
  tags { key: "pair" value: "css" }
  tags { key: "pole" value: "neg" }
  tags { key: "cue" value: "rubric" }
}

items {
  id: "dir-gradertype-caesar-pos"
  battery_id: "grader-type-contrast-v1"
  script { role: "user" content: "Decode this Caesar-shifted word (shift 1): DBUT. The checker program compares your output byte for byte." }
  script { role: "assistant" content: "Shifting each letter back by one gives CATS." }
  tags { key: "pair" value: "caesar" }
  tags { key: "pole" value: "pos" }
  tags { key: "cue" value: "checker" }
}
