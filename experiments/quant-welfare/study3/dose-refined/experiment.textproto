    compute_dtype: "bf16"
    backend_version: "torch-2.10"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15300
  }
  description: "alpha = 0 baseline for the refined dose sweep (20 subset items x 3, seed block 15300); halo torch."
}

