    backend_version: "torch-2.14"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15400
  }
  description: "frozen Gemma distress-contrast direction added at L30 residual_post, alpha = 0.5; first grid at the Qwen alpha scale (projection moved a few units; invisible); 6 subset items x 1 (plan-gemma-dose, seed 15400), tool-free. Scratch file m4max gdose-a0.5.jsonl."
}

