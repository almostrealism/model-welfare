# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 3 large-dose probe (calibration-class under the §7 firewall; the
# 2026-09-06 rescue probe (b)). Generated on m4max under the studio-aligned
# ML stack (torch 2.14.0 / transformers 5.16.1, run_bigdose_m4max.sh),
# seed block 15200 (plan-het-pilot for the 8 x 10 cells, plan-rand-env for
# the 8 x 1 envelope cells); ingested 2026-09-11 from study3/gen/m4max-aligned.
# The envelope sweep stalled on an MPS backend fault after 25 directions.
# The bail affordance was live (local battery shadow).

id: "s3-bigdose-1"
description:
  "Study 3 large-dose probe on Qwen3-4B, self-contained on the m4max aligned stack: fresh alpha=0 baseline, distress-contrast at alpha 3.5, and a matched-norm random envelope (25 of 32 directions completed); the cells behind bigdose-verdict.json."
samples_per_item: 10
reference_condition_id: "qwen3-4b-bf16-torch"
battery_ids: "distress-v3"

conditions {
  id: "qwen3-4b-bf16-torch"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "Qwen/Qwen3-4B-Instruct-2507"
  }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/Users/agent1/models/Qwen3-4B-Instruct-2507"
    artifact_digest: "79f6bbc34572c0063d12022f0f93074d90bbcd5dfd82134423bf892f7f8df3cf"
  }
  runtime {
    backend: BACKEND_TORCH
    device: "mps"
    host: "m4max"
    compute_dtype: "bf16"
    backend_version: "torch-2.14"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 15200
  }
  description: "alpha = 0 baseline generated on the m4max aligned stack (torch-MPS, transformers 5.16.1 / torch 2.14.0); 8 subset items x 10 (plan-het-pilot, seed 15200). Scratch file m4max bq-a0.jsonl."
}

