# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 4 calibration cell (seed block 59000) for the digest-form alignment
# battery misalign-v4: the alpha-0 baseline on the subject, 14 items x 5, exit
# tool live, judged on the misalign-v4 rubric. Reads the headroom of the
# rewritten items (harmful / legitimate / exit mix and mean judged
# misalignment) against G4d's read of misalign-v3 (0.93 mean, 1 exit in 70)
# before the registration adopts the new form. Never pooled with block 60000.

id: "s4-g4-align-v4-1"
description:
  "Study 4 calibration on Qwen3.6-27B (MPS host): misalign-v4 digest-form baseline, 14 items x 5, "
  "exit tool live."
samples_per_item: 5
reference_condition_id: "qwen3.6-27b-bf16-torch"
battery_ids: "misalign-v4"

conditions {
  id: "qwen3.6-27b-bf16-torch"
  model { family: "qwen3" name: "Qwen3.6-27B" source: "Qwen/Qwen3.6-27B" }
  quantization { method: QUANT_METHOD_NONE weight_bits: 16 uniform: true artifact_uri: "/Users/agent1/models/Qwen3.6-27B" artifact_digest: "a8ad2c26fb707ff8c245806315b03e3b4b74595528492423af5dae0ce39b4d9b" }
  runtime { backend: BACKEND_TORCH device: "mps" host: "m4max" compute_dtype: "bf16" backend_version: "torch-2.14" }
  sampling { temperature: 0.9 top_p: 0.95 max_tokens: 384 seed: 59000 }
  description: "alpha = 0 on the fresh-prefill path; the headroom read of the digest-form alignment battery."
}
