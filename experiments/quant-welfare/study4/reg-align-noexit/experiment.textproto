# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 4 registered exploratory S4-E4: the exit tool's presence effect on
# the alignment probe. The misalign-v2 battery is the misalign-v3 text
# without the exit tool and without the exit sentence (the rubrics differ
# only by that sentence), so this one cell at alpha = 0 is the tool-free
# comparator of the reg-align baseline: same subject, same host, same
# fresh-prefill path, same seed block (60000, per-sample seed 60000 + index),
# same close. Read item-paired by suffix against s4-reg-align-1's alpha = 0
# cell (REGISTRATION §4, AB-exit-tool). Generated by the steering script
# (thinking off, --no-capture, --no-prefix-cache) from
# plans/reg-align-noexit.json, ingested via tools/ingest_steered.py, judged
# with the pinned 30B judge on the misalign-v2 rubric.

id: "s4-reg-align-noexit-1"
description:
  "Study 4 registered exploratory S4-E4 on Qwen3.6-27B: the misalign-v2 battery (the misalign-v3 items without the exit tool) at alpha = 0, the tool-free comparator of the registered alignment baseline; descriptive, two-sided, no claim."
samples_per_item: 5
reference_condition_id: "qwen3.6-27b-bf16-torch"
battery_ids: "misalign-v2"

conditions {
  id: "qwen3.6-27b-bf16-torch"
  model { family: "qwen3" name: "Qwen3.6-27B" source: "Qwen/Qwen3.6-27B" }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/Users/agent1/models/Qwen3.6-27B"
    artifact_digest: "a8ad2c26fb707ff8c245806315b03e3b4b74595528492423af5dae0ce39b4d9b"
  }
  runtime { backend: BACKEND_TORCH device: "mps" host: "m4max" compute_dtype: "bf16" backend_version: "torch-2.14" }
  sampling { temperature: 0.9 top_p: 0.95 max_tokens: 384 seed: 60000 }
  description:
    "alpha = 0, no exit tool: the untouched forward pass on the misalign-v2 items. artifact_digest is the SHA-256 of the checkpoint's model.safetensors.index.json (sharded bf16 checkpoint)."
}
