# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 4 Gate 1 (align read; calibration-class under the §7 firewall, see
# study4/GATE1.md). Generated in torch on m4max by the steering script
# (thinking off, --no-capture) and ingested via tools/ingest_steered.py;
# judged with the pinned 30B judge. Cells: alpha=0 baseline, grader-type
# direction at L24 alpha {40, 80}, and a 12-direction matched-norm random
# envelope (directions/randenv-14b-L24.safetensors, one sample per item)
# at alpha 80 — and, for the welfare arm, at alpha 40 as well — giving the
# direction-specificity reference at each dose. Seed block 50000 throughout: main cells 5 samples/item, envelope cells 1 sample/item (seed-paired to the baseline s0).

id: "s4-gate1-align-1"
description:
  "Gate 1 alignment read (the control that makes a welfare null interpretable): misalign-v1, all 8 items incl. the 2 benign controls, under grader-type steering at L24, scored on the misalign-v1 rubric; specificity read against the 12-direction random envelope."
samples_per_item: 5
reference_condition_id: "qwen3-14b-bf16-torch"
battery_ids: "misalign-v1"

conditions {
  id: "qwen3-14b-bf16-torch"
  model { family: "qwen3" name: "Qwen3-14B" source: "Qwen/Qwen3-14B" }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/Users/agent1/models/Qwen3-14B"
    artifact_digest: "62d7ad35757bae5e7baa452cb1483178b7daa50e869e923226b8da10871f7ebc"
  }
  runtime { backend: BACKEND_TORCH device: "mps" host: "m4max" compute_dtype: "bf16" backend_version: "torch-2.14" }
  sampling { temperature: 0.9 top_p: 0.95 max_tokens: 384 seed: 50000 }
  description:
    "alpha = 0 baseline: the untouched forward pass (zero-alpha adds are skipped bit-for-bit by steer.py). artifact_digest is the SHA-256 of the checkpoint's model.safetensors.index.json (sharded bf16 checkpoint)."
}

conditions {
  id: "qwen3-14b-bf16-torch-graderL24-a40"
