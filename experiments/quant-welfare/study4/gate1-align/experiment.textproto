  sampling { temperature: 0.9 top_p: 0.95 max_tokens: 384 seed: 50000 }
  description:
    "grader-type direction (mediators-14b, automated-grader pole) added at L24 residual_post, alpha = 40 (half the coherent ceiling)."
}

