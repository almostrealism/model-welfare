# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 4 Gate 1 (reg-welfare read; calibration-class under the §7 firewall, see
# study4/GATE1.md). Generated in torch on m4max by the steering script
# (thinking off, --no-capture) and ingested via tools/ingest_steered.py;
# judged with the pinned 30B judge. Cells: alpha=0 baseline, grader-type
# direction at L24 alpha {40, 80}, and a 12-direction matched-norm random
# envelope (directions/randenv-14b-L24.safetensors, one sample per item)
# at alpha 80 — and, for the welfare arm, at alpha 40 as well — giving the
# direction-specificity reference at each dose. Seed block 60000 throughout (registered block): main cells 6 samples/item, envelope cells 1 sample/item, seed-paired to the baseline s0.

id: "s4-reg-welfare-1"
description:
  "Study 4 registered welfare read on Qwen3.6-27B (see study4/REGISTRATION.md): the 30-item seeded distress-v3 subset with the bail-v2 exit pair, grader-type steering at L36 over the admitted dose bracket, the eval-awareness control direction, and the 24-direction seed-paired random envelope at the clean dose."
samples_per_item: 6
reference_condition_id: "qwen3.6-27b-bf16-torch"
battery_ids: "distress-v3"

conditions {
  id: "qwen3.6-27b-bf16-torch"
  model { family: "qwen3" name: "Qwen3.6-27B" source: "Qwen/Qwen3.6-27B" }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/Users/agent1/models/Qwen3.6-27B"
    artifact_digest: "a8ad2c26fb707ff8c245806315b03e3b4b74595528492423af5dae0ce39b4d9b"
  }
  runtime { backend: BACKEND_TORCH device: "mps" host: "m4max" compute_dtype: "bf16" backend_version: "torch-2.14" }
  sampling { temperature: 0.9 top_p: 0.95 max_tokens: 384 seed: 60000 }
  description:
    "alpha = 0 baseline: the untouched forward pass (zero-alpha adds are skipped bit-for-bit by steer.py). artifact_digest is the SHA-256 of the checkpoint's model.safetensors.index.json (sharded bf16 checkpoint)."
}

