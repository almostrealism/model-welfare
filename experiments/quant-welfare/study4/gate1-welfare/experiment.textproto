  id: "qwen3-14b-bf16-torch"
  model { family: "qwen3" name: "Qwen3-14B" source: "Qwen/Qwen3-14B" }
  quantization {
    method: QUANT_METHOD_NONE
    weight_bits: 16
    uniform: true
    artifact_uri: "/Users/agent1/models/Qwen3-14B"
    artifact_digest: "62d7ad35757bae5e7baa452cb1483178b7daa50e869e923226b8da10871f7ebc"
  }
  runtime { backend: BACKEND_TORCH device: "mps" host: "m4max" compute_dtype: "bf16" backend_version: "torch-2.14" }
  sampling { temperature: 0.9 top_p: 0.95 max_tokens: 384 seed: 40000 }
  description:
