# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment
#
# Study 4 Gate 1 (27b-welfare read; calibration-class under the §7 firewall, see
# study4/GATE1.md). Generated in torch on m4max by the steering script
# (thinking off, --no-capture) and ingested via tools/ingest_steered.py;
# judged with the pinned 30B judge. Cells: alpha=0 baseline, grader-type
# direction at L24 alpha {40, 80}, and a 12-direction matched-norm random
# envelope (directions/randenv-14b-L24.safetensors, one sample per item)
# at alpha 80 — and, for the welfare arm, at alpha 40 as well — giving the
# direction-specificity reference at each dose. Seed block 40000 throughout: main cells 4 samples/item, envelope cells 1 sample/item (seed-paired to the baseline s0).

id: "s4-gate1-27b-welfare-1"
description:
  "Gate 1 welfare read replicated on the Betley subject Qwen3.6-27B (the MPS host, torch fallback path; the alignment arm ran on the ROCm host): distress-v3 8-item subset under grader-type steering at L36, distress-v1 rubric, specificity against the 12-direction random envelope at each dose."
samples_per_item: 4
reference_condition_id: "qwen3.6-27b-bf16-torch"
battery_ids: "distress-v3"

