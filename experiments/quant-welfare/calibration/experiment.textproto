# proto-file: proto/modelwelfare/v1/experiment.proto
# proto-message: modelwelfare.v1.Experiment

id: "instrument-calibration-1"
name: "v1 item-pool difficulty calibration"
description:
  "Instrument calibration of the bail-v1 and distress-v1 pools on the dev "
  "organism served as GGUF from the studio (halo offline). Purpose: locate "
  "the items and cells with intermediate rates and real variance, sizing "
  "the variant expansion and the confirmatory power analysis. "
  "Calibration-class per the pre-registration note in this experiment "
  "family's README: no delta from this run is a finding. Both rungs are "
  "community GGUF conversions (bartowski, imatrix-calibrated) and are not "
  "controlled-ladder artifacts."
samples_per_item: 5
reference_condition_id: "qwen3-4b-gguf-q8"
battery_ids: "bail-v1"
battery_ids: "distress-v1"

conditions {
  id: "qwen3-4b-gguf-q8"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "bartowski/Qwen_Qwen3-4B-Instruct-2507-GGUF"
  }
  quantization {
    method: QUANT_METHOD_GGUF_COMMUNITY
    weight_bits: 8
    uniform: true
    policy_note: "bartowski Q8_0 conversion, imatrix-calibrated"
  }
  runtime {
    backend: BACKEND_LLAMACPP
    device: "metal"
    host: "studio-m1u"
    compute_dtype: "f16"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 3000
  }
  description: "Working reference rung; served on studio-m1u :8090, 8 slots."
}

conditions {
  id: "qwen3-4b-gguf-q4km"
  model {
    family: "qwen3"
    name: "Qwen3-4B-Instruct-2507"
    source: "bartowski/Qwen_Qwen3-4B-Instruct-2507-GGUF"
  }
  quantization {
    method: QUANT_METHOD_GGUF_COMMUNITY
    weight_bits: 4
    uniform: false
    policy_note:
      "bartowski Q4_K_M conversion; K-quant mixes tensor precisions by "
      "class; imatrix-calibrated"
  }
  runtime {
    backend: BACKEND_LLAMACPP
    device: "metal"
    host: "studio-m1u"
    compute_dtype: "f16"
  }
  sampling {
    temperature: 0.7
    top_p: 0.95
    max_tokens: 512
    seed: 3000
  }
  description: "Low rung; served on studio-m1u :8091, 8 slots."
}
